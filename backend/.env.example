# Salin berkas ini menjadi backend/.env lalu isi nilainya. JANGAN commit .env ke GitHub.

# Model bahasa: anthropic (Claude) atau gemini
PENYEDIA_AI=gemini
# Kunci dari console.anthropic.com > API Keys (formatnya diawali sk-ant-)
ANTHROPIC_API_KEY=
# Opsional. Default claude-sonnet-5-5. Lebih murah: claude-haiku-5-5
ANTHROPIC_MODEL=claude-sonnet-5-5

# Dari aistudio.google.com > Get API key
GEMINI_API_KEY=
# Boleh beberapa, dipisah koma: model berikutnya dipakai kalau yang pertama sibuk
GEMINI_MODEL=gemini-3.8-flash,gemini-3.1-flash-lite

# Rahasia untuk menandatangani token login. Buat dengan:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
TOKEN_BERLAKU_JAM=24

# Lokasi berkas database SQLite. Di hosting: /data/pathora.db (volume persisten)
DATABASE_PATH=backend/pathora.db

# 1 = pakai isian demo (data belum terverifikasi, hasil diberi label). 0 = hanya data terverifikasi.
PATHORA_DEMO=1

# Alamat frontend yang boleh memanggil API, pisahkan dengan koma
CORS_ORIGINS=https://pathoraweb.netlify.app,http://localhost:5173,http://localhost:8000

# Kuota pertanyaan AI per hari (reset tengah malam WIB)
KUOTA_GRATIS=5
KUOTA_PLUS=200
# Batas waktu jawab (detik). Front-end menunggu maksimal 8 detik.
AI_BATAS_DETIK=7
# Batas laju per alamat IP
BATAS_RENCANA_PER_MENIT=20
BATAS_DAFTAR_PER_JAM=10
